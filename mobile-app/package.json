  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "tunnel": "EXPO_UNSTABLE_HEADLESS=1 expo start --tunnel",
    "start:tunnel": "EXPO_UNSTABLE_HEADLESS=1 expo start --tunnel",
    "tunnel:prod": "EXPO_UNSTABLE_HEADLESS=1 expo start --tunnel --no-dev --minify",
    "tunnel:web": "EXPO_UNSTABLE_HEADLESS=1 expo start --tunnel --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "npx expo export --platform web",
    "qr": "node -e \"const q = require('qrcode-terminal'); q.generate('exp://gl_pbqw-rualisher-8082.exp.direct', { small: true });\""
  },
  "private": true,
  "devDependencies": {
    "qrcode-terminal": "^0.12.0"
  }
