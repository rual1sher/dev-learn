# ==============================================================================
# ⚡ DevLearn Platform — Конфигурация переменных окружения (Production & Staging)
# Скопируйте этот файл в .env и укажите актуальные значения для вашего сервера:
# cp .env.example .env
# ==============================================================================

# Режим работы приложения ('production' или 'development')
NODE_ENV=production

# Порт и хост сервера
PORT=3001
HOST=0.0.0.0

# Путь к файлу SQLite базы данных
# Для локального запуска: ./api/database.db
# Для Docker: /app/data/database.db
DB_PATH=./api/database.db

# Настройка CORS (разрешенные домены через запятую или * для открытого API)
# Пример для прода: CORS_ORIGIN=https://devlearn.uz,https://app.devlearn.uz
CORS_ORIGIN=*

# Секретный ключ для подписи JWT-токенов (ОБЯЗАТЕЛЬНО замените на длинную случайную строку в проде!)
# Сгенерировать ключ в Linux: openssl rand -hex 32
JWT_SECRET=your-super-secret-production-jwt-key-change-me

# Ограничение частоты запросов (Rate Limiting)
# RATE_LIMIT_WINDOW_MS: окно времени в миллисекундах (900000 = 15 минут)
# RATE_LIMIT_MAX: максимальное количество запросов с одного IP за окно
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Доверие заголовкам Reverse Proxy (X-Forwarded-For, X-Forwarded-Proto)
# Установите в true, если сервер работает за Nginx, Cloudflare или Traefik
TRUST_PROXY=true

# Раздача собранного Web-клиента (React Native Web SPA) сервером Express
# true: Express отдает веб-приложение на корневом роуте /
# false: только чистый REST API (если веб раздается напрямую через Nginx)
SERVE_STATIC=true

# Путь к собранному бандлу Web-клиента
STATIC_PATH=./mobile-app/dist

# Токен доступа Expo CLI (для работы без ввода логина/пароля в консоли)
# Получите бесплатно на https://expo.dev/settings/access-tokens
EXPO_TOKEN=
